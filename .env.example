# Settings for the desktop scripts in this repo (not the device; that uses settings.toml).
# Copy to .env and adjust: cp .env.example .env
# .env is not tracked. Variables already set in the environment take precedence.

# Device MQTT topic prefix: MQTT_TOPIC in the device's settings.toml (scripts/tmux.sh)
HEARTHMATE_TOPIC=burnie

# MQTT broker host (scripts/tmux.sh). Optional if -h is set in ~/.config/mosquitto_sub, which is
# also where the broker username and password belong (-u and -P lines), not here.
HEARTHMATE_MQTT_HOST=homeassistant

# tmux session name (scripts/tmux.sh)
HEARTHMATE_SESSION=hearthmate

# Directory of the StoveLink HDF5 burn files (simulation/)
BURNIE_DATA=/Volumes/Burnie

# Host running the StoveLink service, and its data directory (burnlog in the run-hearthmate skill).
# The share serves stale contents of files the service still has open, so the current burn's log
# is read there over ssh.
STOVELINK_HOST=stovelink
STOVELINK_DATA=/mnt/burnie

# CircuitPython device for scripts/deploy.sh (wwshell, circup): its hostname, and the web workflow
# password, CIRCUITPY_WEB_API_PASSWORD in its settings.toml. Put the real password only in .env.
CP_HOST=cpy-ather_esp32_v2-901506d38018
CIRCUP_WEBWORKFLOW_PASSWORD=
